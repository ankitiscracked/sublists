{
  "manifest_version": 3,
  "name": "Sublists",
  "version": "0.10.0",
  "description": "Organize Substack posts and Notes in real Apple Notes folders, with thumbnails and links. Requires the included macOS companion.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sublists setup",
    "default_popup": "setup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.substack.com/*"
      ],
      "js": [
        "posts.js",
        "content.js",
        "lists.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
